Approach- Moores Voting Algorithm
Take a variable to store count, and take int el;
iterate and if at any point count is 0, we reinitialise the count to 1 and start again
if the current element = our desired el, we increase count, else decrease it

class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int n = nums.size();
        int cnt = 0;
        int el;

        for(int i = 0; i<n; i++){
            if(cnt == 0){
                cnt = 1;
                el = nums[i];
            }

            if(nums[i] == el) cnt++;

            else cnt--;
        }
        return el;
    }
};
