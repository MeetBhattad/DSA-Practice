Approach-
Its kind of 2 pointer problem
we run a loop with i and first check if our i == i-1 then continue, also check if nums[i] > 0 then break;
take j = i+1 and k = n-1;
now run a while loop j < k and sum = i + j + k;
if sum is lesser than 0 then increase j if its greater than 0 then increase k
now if sum = 0 then make a temp with i j k and add it to ans, move j and k also check it doesnt repeat itself
by checking while(nums[j] == nums[j-1] and j < k) j++, same for k and k--;

class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        int n = nums.size();
        vector<vector<int>> ans;
        sort(nums.begin(), nums.end());
        for(int i = 0; i<n-2; i++){
            if(i>0 && nums[i] == nums[i-1]) continue;
            if(nums[i] > 0) break;
            int j = i+1;
            int k = n-1;

            while(j<k){
            int sum = nums[i] + nums[j] + nums[k];
            if(sum < 0){
                j++;
            }
            else if(sum > 0) k--;
            else{
                vector<int> temp = {nums[i], nums[j], nums[k]};
                ans.push_back(temp);
                j++;
                k--;
                while(nums[j] == nums[j-1] && j < k) j++;
                while(nums[k] == nums[k+1] && j < k) k--;
            }
            }
        }
        return ans;
    }
};
