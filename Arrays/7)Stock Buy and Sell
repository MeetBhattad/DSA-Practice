Approach- DP
Take a variable to track the minimum price of the stock
take a variable to count the maxprofit

if the current price is lesser than minimum, update the minimum
else, calculate the maxprofit by currentprice - minimum

class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n = prices.size();
        int mini = INT_MAX;
        int maxprofit = 0;

        for(int i = 0; i<n; i++){
            if(prices[i] < mini){
                mini = prices[i];
            }

            else{
                maxprofit = max(maxprofit, prices[i]-mini);
            }
        }
        return maxprofit;
    }
};
