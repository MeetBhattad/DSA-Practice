Approach- Kadanes Algorithm
initialise maxi to INT_MAX, sum to be 0
iterate and increase sum, update maxi. if at any point sum < 0, reinitialise the sum to be 0.

class Solution {
public:
    int maxSubArray(vector<int>& nums) {
        int n = nums.size();
        int maxi = INT_MIN;
        int sum = 0;

        for(int i = 0; i<n; i++){
            sum += nums[i];
            maxi = max(maxi, sum);

            if(sum < 0){
                sum = 0;
            }
        }
        return maxi;
    }
};
