Approach-
We first calculate the no. of bouquets we can make. it would be equal to (count/k) where k is adjacent no of flowers reqd.
if the current day is <= day,  we increase the count. if its not equal, we calc the no of bouq, reset cnt to 0 and in the end again 
calc the remaning bouqs made
then use that in main logic to check if its possible, mid would be the ans and move right i.e high = mid - 1;

class Solution {
private:
    bool possible(vector<int> &bloomDay, int days, int m, int k){
        int n = bloomDay.size();
        int cnt = 0;
        int noOfB = 0;
        for(int i = 0; i<n; i++){
            if(bloomDay[i] <= days){
                cnt ++;
            }
            else{
                noOfB += (cnt/k);
                cnt = 0;
            }
        }
        noOfB += (cnt/k);
        return noOfB >= m;
    }
public:
    int minDays(vector<int>& bloomDay, int m, int k) {
        int n = bloomDay.size();
        long long value = m * 1LL * k * 1LL;
        if(value > n) return -1;
        int mini = INT_MAX, maxi = INT_MIN;
        for(int i = 0; i<n; i++){
            mini = min(mini, bloomDay[i]);
            maxi = max(maxi, bloomDay[i]);
        }

        int low = mini, high = maxi, ans = high;
        while(low <= high){
            int mid = (low+high)/2;
            if(possible(bloomDay, mid, m, k)){
                ans = mid;
                high = mid - 1;
            }
            else low = mid+1;
        }
        return ans;
    }
};
